# Server port
PORT=1198

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/backend_contact_form_api

# Use long random values in real environments
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ADMIN_REGISTRATION_SECRET=replace_with_a_private_admin_setup_secret

# Frontend origin allowed to send credentialed requests
CLIENT_ORIGIN=http://localhost:5173

# Use production to enable secure cookies over HTTPS
NODE_ENV=development
