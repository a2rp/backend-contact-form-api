# Server port
PORT=1198

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/backend_contact_form_api

# Replace both placeholders with unique random secrets of at least 32 characters
JWT_SECRET=change_me_generate_a_random_secret_of_at_least_32_chars
ADMIN_REGISTRATION_SECRET=change_me_generate_a_second_random_secret_of_at_least_32_chars

# Comma-separated frontend origins allowed to send credentialed requests
CLIENT_ORIGIN=http://localhost:5173

# Use production to enable secure cookies over HTTPS
NODE_ENV=development
